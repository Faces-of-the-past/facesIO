    <cidoc:p102_has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string"><![CDATA[Inv. Real Museo, 1857]]></cidoc:p102_has_title>
    <ecidoc:p3_has_note_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string"><![CDATA[Velázquez. / 155. Cuadro llamado de Las Meninas. / A la izquierda del espectador esta Velázquez con la paleta en la mano, haciendo el retrato de Felipe 4º y de la reina, los cuales se ven reflejados en un espejo colocado al fondo del estudio. En primer termino y en el centro esta la infanta doña Margarita Maria de Austria, a quien entretienen sus meninas de diversos modos. Ocupan la derecha los dos enanos Mari Barbola y Nicolasico Pertusato con el perro favorito, el cual sufre con paciencia las impertinencias del bufon (C.N.) / Alto 11 pies, 5 pulg; ancho 9 pies, 11 pulg.]]></ecidoc:p3_has_note_id>
    <cidoc:p4_has_time-span rdf:datatype="http://www.w3.org/2001/XMLSchema#date">18570000000000</cidoc:p4_has_time-span>
